# Internal development notebook, not published. The scripts and figures under
# docs/ are published: they are the reproducible part, and a figure nobody can
# regenerate is a claim nobody can check.
DEVELOPMENT.md
docs/scripts/__pycache__/

# Regenerable caches. The JSON summaries beside them are published, because
# they are the numbers the notebook quotes; the arrays are just how they were
# obtained and `analysis.py` rebuilds them.
docs/data/*.npz
docs/data/*.npy

# The official ROS logo is CC BY-NC 4.0 and covered by the ROS trademark
# policy; this repository is Apache-2.0, so the mark is fetched, not vendored.
# docs/scripts/fetch_artwork.sh downloads it.
docs/artwork/

# Artwork used to test the pipeline that is not this repository's to publish:
# a personal photograph, and two organisations' logos. The trajectories derived
# from them are published, the artwork is not - the same rule the ROS mark gets.
docs/images/foto.jpg
docs/images/logo semillero robotica.jpg
docs/images/logocolectivohagamos.webp

# A trajectory that is both large and fully reproducible from inputs this
# repository does carry. The other four stay: three derive from artwork that is
# not ours to publish, so the trajectory is the only copy, and ros_logo is the
# default and should work on a fresh clone. Regenerate this one with
#   python3 docs/scripts/export_trajectory.py \
#       --image docs/images/ingeniero.png --name ingeniero --pitch 0.5
src/tattotronix_control/config/trajectories/ingeniero.npz
