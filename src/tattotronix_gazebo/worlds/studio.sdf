<?xml version="1.0" ?>
<!--
  TATTOTRONIX studio world for Gazebo Sim (Fortress).

  Deliberately bare: a ground plane, a light, a bench at the height the arm is
  bolted to, and a flat panel standing in for the work surface the needle
  touches. Everything the arm has to reason about is geometry it can collide
  with; scenery would only cost frames.

  The panel is a placeholder for skin. It is rigid, so contact is stiff and
  honest about it. Modelling compliant tissue is a separate piece of work and
  pretending otherwise here would hide it.
-->
<sdf version="1.8">
  <world name="studio">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.8066</gravity>

    <scene>
      <ambient>0.45 0.45 0.50 1</ambient>
      <background>0.12 0.13 0.16 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.23 0.25 1</ambient>
            <diffuse>0.30 0.31 0.34 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Work bench. 0.75 m is a standard bench height and the arm is bolted
         to the top face, so the description spawns at z = 0.75. The top is
         0.70 x 0.50 m, sized to the arm rather than to a room: at the zero
         pose the flange sits 214 mm out from the base and the pen tip 259 mm,
         so a bench wider than this is scenery the robot can never touch. -->
    <model name="bench">
      <static>true</static>
      <pose>0 0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.70 0.50 0.75</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.70 0.50 0.75</size></box>
          </geometry>
          <material>
            <ambient>0.18 0.16 0.14 1</ambient>
            <diffuse>0.35 0.28 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Work surface: a 20 x 14 cm panel 5 mm thick, lying flat in front of
         the arm, so the arm starts above it rather than having to travel to
         find it. This is what tattoo paths are projected onto.

         Centred at x = 0.21 m, which is under the flange. The tip lands 49 mm
         further out, at x = 259 mm, because the tool axis runs along the
         bracket's +x; that is still well inside the 200 mm panel. Centring on
         the tip would mean moving this to x = 0.259. -->
    <model name="work_surface">
      <static>true</static>
      <pose>0.21 0.0 0.7525 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.20 0.14 0.005</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.20 0.14 0.005</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.42 0.38 1</ambient>
            <diffuse>0.82 0.63 0.56 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!--
      GUI layout. Fortress drops every default plugin as soon as a world
      declares a <gui> block, so the standard set is listed explicitly. The
      reason to declare it at all is camera_pose: the default camera sits at
      the origin looking down the world +x axis, which for a 400 mm arm on a
      750 mm bench frames the underside of the bench. This puts the arm and
      the work surface in shot the moment the world opens.
    -->
    <gui fullscreen="0">

      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.45 0.45 0.50</ambient_light>
        <background_color>0.12 0.13 0.16</background_color>
        <camera_pose>1.20 -1.00 1.25 0 0.30 2.42</camera_pose>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <!-- These plugins have no UI of their own. Left at their default
               size they render their own help text over the render window, so
               the card is collapsed to nothing and made transparent. -->
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="cardBackground" type="string">#00000000</property>
        </ignition-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <!-- These plugins have no UI of their own. Left at their default
               size they render their own help text over the render window, so
               the card is collapsed to nothing and made transparent. -->
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="cardBackground" type="string">#00000000</property>
        </ignition-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <!-- These plugins have no UI of their own. Left at their default
               size they render their own help text over the render window, so
               the card is collapsed to nothing and made transparent. -->
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="cardBackground" type="string">#00000000</property>
        </ignition-gui>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui>
          <!-- These plugins have no UI of their own. Left at their default
               size they render their own help text over the render window, so
               the card is collapsed to nothing and made transparent. -->
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="cardBackground" type="string">#00000000</property>
        </ignition-gui>
      </plugin>

      <plugin filename="SelectEntities" name="Select Entities">
        <ignition-gui>
          <!-- These plugins have no UI of their own. Left at their default
               size they render their own help text over the render window, so
               the card is collapsed to nothing and made transparent. -->
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="cardBackground" type="string">#00000000</property>
        </ignition-gui>
      </plugin>

      <plugin filename="MarkerManager" name="Marker manager">
        <ignition-gui>
          <!-- These plugins have no UI of their own. Left at their default
               size they render their own help text over the render window, so
               the card is collapsed to nothing and made transparent. -->
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="cardBackground" type="string">#00000000</property>
        </ignition-gui>
      </plugin>

      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <ignition-gui>
          <!-- These plugins have no UI of their own. Left at their default
               size they render their own help text over the render window, so
               the card is collapsed to nothing and made transparent. -->
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="cardBackground" type="string">#00000000</property>
        </ignition-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree"/>

    </gui>

  </world>
</sdf>
