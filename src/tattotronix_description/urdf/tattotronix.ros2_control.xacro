<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ros2_control hardware description.

    One <ros2_control> block serves every backend; only the plugin swaps.
      gz    -> gz_ros2_control/GazeboSimSystem, driven by Gazebo Sim (Fortress)
      mock  -> mock_components/GenericSystem, for testing controllers and
               MoveIt with no simulator and no hardware attached
      pca9685 -> tattotronix_hardware/Pca9685ServoSystem, the arm as built:
               hobby servos driven through a PCA9685 board. Each joint gets
               its channel and calibration from servo_calibration.
    tattotronix.urdf.xacro rejects any other backend, so an unknown one fails
    at expansion rather than producing a description that controls nothing.

    The pca9685 joints have no effort state. A hobby servo reports nothing, so
    the driver refuses to invent one, and its position and velocity states are
    the command it last sent rather than a measurement.
  -->

  <xacro:macro name="tattotronix_ros2_control"
               params="name hardware i2c_device:=/dev/i2c-1 i2c_address:=64 dry_run:=false
                       servo_calibration:=''">

    <ros2_control name="${name}" type="system">

      <xacro:if value="${hardware == 'gz'}">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:if>

      <xacro:if value="${hardware == 'mock'}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">false</param>
          <param name="state_following_offset">0.0</param>
        </hardware>
      </xacro:if>

      <xacro:if value="${hardware == 'pca9685'}">
        <xacro:property name="calibration" value="${xacro.load_yaml(servo_calibration)}"/>
        <hardware>
          <plugin>tattotronix_hardware/Pca9685ServoSystem</plugin>
          <param name="i2c_device">${i2c_device}</param>
          <param name="i2c_address">${i2c_address}</param>
          <param name="frame_rate_hz">50</param>
          <param name="oscillator_hz">25000000</param>
          <param name="dry_run">${dry_run}</param>
        </hardware>
      </xacro:if>

      <xacro:macro name="controlled_joint" params="name initial_position">
        <joint name="${name}">
          <command_interface name="position">
            <param name="min">-1.57</param>
            <param name="max">1.57</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">${initial_position}</param>
          </state_interface>
          <state_interface name="velocity"/>
          <xacro:unless value="${hardware == 'pca9685'}">
            <state_interface name="effort"/>
          </xacro:unless>
          <xacro:if value="${hardware == 'pca9685'}">
            <xacro:property name="servo" value="${calibration['servos'][name]}"/>
            <param name="channel">${servo['channel']}</param>
            <param name="zero_us">${servo['zero_us']}</param>
            <param name="us_per_rad">${servo['us_per_rad']}</param>
            <param name="min_us">${servo['min_us']}</param>
            <param name="max_us">${servo['max_us']}</param>
            <xacro:if value="${'channel_b' in servo}">
              <param name="channel_b">${servo['channel_b']}</param>
              <param name="zero_us_b">${servo['zero_us_b']}</param>
              <param name="us_per_rad_b">${servo['us_per_rad_b']}</param>
            </xacro:if>
          </xacro:if>
        </joint>
      </xacro:macro>

      <xacro:controlled_joint name="joint_1" initial_position="0.0"/>
      <xacro:controlled_joint name="joint_2" initial_position="0.0"/>
      <xacro:controlled_joint name="joint_3" initial_position="0.0"/>
      <xacro:controlled_joint name="joint_4" initial_position="0.0"/>
      <xacro:controlled_joint name="joint_5" initial_position="0.0"/>

    </ros2_control>

  </xacro:macro>

</robot>
