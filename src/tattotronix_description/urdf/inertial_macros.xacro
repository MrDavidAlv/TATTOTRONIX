<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Inertia helpers.

    The CAD behind the meshes does not ship mass properties, so every link is
    approximated by the solid primitive that best matches its bounding box.
    These numbers are good enough to keep the physics solver stable and to let
    ros2_control tune gains against something physical; they are NOT the real
    inertia tensors and must be replaced once the CAD exports them.
  -->

  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (x*x + z*z) / 12.0}" iyz="0.0"
               izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cylinder" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (3.0*radius*radius + length*length) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (3.0*radius*radius + length*length) / 12.0}" iyz="0.0"
               izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

</robot>
