<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tattotronix">

  <!--
    TATTOTRONIX: 5 DOF manipulator, ROS 2 Humble.

    Built to hold a tattoo pen, but nothing below the tool flange knows that.
    Swap the tool argument and the same arm carries a different end effector.

    Arguments
      hardware          gz | mock | pca9685 | none
                        'none' leaves ros2_control out entirely, which is what
                        display.launch.py wants: a description RViz can render
                        with joint_state_publisher_gui and no controller stack.
                        'pca9685' is the arm as built: its hobby servos driven
                        through a PCA9685 board by tattotronix_hardware.
      i2c_device        pca9685 only: the Linux I2C bus the board is on.
      i2c_address       pca9685 only: the board's address; 64 is 0x40, the
                        address with no jumpers soldered.
      dry_run           pca9685 only: true runs the whole stack with the board
                        simulated, sending nothing. For a first run, and for CI.
      servo_calibration pca9685 only: which channel drives each joint and how
                        its pulse maps to the angle. The default is declared,
                        not measured; see config/servo_calibration.yaml.
      tool              tattoo | none
                        The pen in tattoo_tool.xacro is primitives sized to a
                        catalogue rotary machine, not measured hardware. It is
                        the default because the TCP the tattoo paths are
                        planned for has to exist; 'none' strips it back to the
                        exported CAD when the question is about the arm.
      controllers_file  absolute path to the controller manager YAML, read by
                        the Gazebo plugin. Only consulted when hardware=gz.
      use_world_link    true bolts base_link to a world link, which is how the
                        arm is anchored in simulation. Set false when the
                        description is embedded in a larger cell.
      mass_model        printed (default) is the arm as built: each link's
                        printed shell, integrated from its mesh, plus the servos
                        mounted in it, generated into inertials_printed.xacro by
                        docs/scripts/mass_properties.py. box is the earlier
                        approximation by the solid box that fits each link's
                        bounding box, with masses written by hand - kept so the
                        two can be compared, and heavier than the arm by a factor
                        of about eight. Only inertia changes; geometry and
                        kinematics are identical in both.
  -->

  <xacro:arg name="hardware" default="none"/>
  <xacro:arg name="tool" default="tattoo"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="use_world_link" default="true"/>
  <xacro:arg name="mass_model" default="printed"/>
  <xacro:arg name="i2c_device" default="/dev/i2c-1"/>
  <xacro:arg name="i2c_address" default="64"/>
  <xacro:arg name="dry_run" default="false"/>
  <xacro:arg name="servo_calibration"
             default="$(find tattotronix_description)/config/servo_calibration.yaml"/>

  <xacro:property name="hardware" value="$(arg hardware)"/>
  <xacro:property name="tool" value="$(arg tool)"/>
  <xacro:property name="use_world_link" value="$(arg use_world_link)"/>
  <xacro:property name="mass_model" value="$(arg mass_model)"/>

  <!-- An unknown model would otherwise match neither branch in arm_macro and
       leave every arm link with no inertial at all: a massless robot that
       Gazebo loads without a word. -->
  <xacro:if value="${mass_model not in ['box', 'printed']}">
    ${xacro.fatal('mass_model must be box or printed, not ' + str(mass_model))}
  </xacro:if>

  <!-- The same for the backend: an unknown one would match no branch in the
       ros2_control macro and give the controller manager a system with no
       hardware in it. -->
  <xacro:if value="${hardware not in ['gz', 'mock', 'pca9685', 'none']}">
    ${xacro.fatal('hardware must be gz, mock, pca9685 or none, not ' + str(hardware))}
  </xacro:if>

  <xacro:include filename="$(find tattotronix_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find tattotronix_description)/urdf/inertials_printed.xacro"/>
  <xacro:include filename="$(find tattotronix_description)/urdf/arm_macro.xacro"/>
  <xacro:include filename="$(find tattotronix_description)/urdf/tattoo_tool.xacro"/>
  <xacro:include filename="$(find tattotronix_description)/urdf/tattotronix.ros2_control.xacro"/>
  <xacro:include filename="$(find tattotronix_description)/urdf/tattotronix.gazebo.xacro"/>

  <xacro:tattotronix_materials/>

  <!-- Anchor. The ROS 1 description referenced a world link it never declared,
       so the tree had a dangling parent and only loaded because nothing
       validated it. -->
  <xacro:if value="${use_world_link}">
    <link name="world"/>
    <xacro:tattotronix_arm parent="world">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:tattotronix_arm>
  </xacro:if>

  <xacro:unless value="${use_world_link}">
    <link name="base_footprint"/>
    <xacro:tattotronix_arm parent="base_footprint">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:tattotronix_arm>
  </xacro:unless>

  <xacro:if value="${tool == 'tattoo'}">
    <xacro:tattoo_tool parent="tool0"/>
  </xacro:if>

  <xacro:unless value="${hardware == 'none'}">
    <xacro:tattotronix_ros2_control name="tattotronix_system" hardware="${hardware}"
      i2c_device="$(arg i2c_device)" i2c_address="$(arg i2c_address)"
      dry_run="$(arg dry_run)" servo_calibration="$(arg servo_calibration)"/>
  </xacro:unless>

  <xacro:if value="${hardware == 'gz'}">
    <xacro:tattotronix_gazebo controllers_file="$(arg controllers_file)"/>
  </xacro:if>

</robot>
